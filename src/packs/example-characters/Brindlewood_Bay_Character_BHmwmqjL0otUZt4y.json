    {
      "name": "The Crown of the Void",
      "type": "checklist",
      "_id": "8MfcOOTLR8qcF777",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "position": 0,
        "description": "<p>When you put on this Crown, mark the first empty box.</p>",
