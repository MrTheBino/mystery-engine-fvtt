    {
      "name": "THE KEY OF THE CHILD",
      "type": "checklist",
      "_id": "LFruMWfkXraaZlY5",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "position": 4,
        "description": "<p>When you turn this Key, mark and narrate any you wish.</p>",
        "isContainer": false,
        "entries": [
          {
            "selected": false,
            "text": "A flashback showing your latchkey kid routine whenever you got home from school."
          },
          {
            "selected": false,
            "text": "A flashback showing how you were an outsider among your school peers."
          },
          {
            "selected": false,
            "text": "A flashback to the moment when you realized your parents were imperfect."
          },
          {
            "selected": false,
            "text": "A flashback to when you felt genuine happiness as a child."
          },
          {
            "selected": false,
            "text": "A flashback to when you experienced childhood trauma."
          },
          {
            "selected": false,
            "text": "A flashback to the moment when you realized childhood wasn't forever."
          },
          {
            "selected": false,
            "text": "A flashback to when you first discovered TV Odyssey."
          }
        ]
