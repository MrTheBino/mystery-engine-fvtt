<div class="items-section">
  <div class="section-header">
    <h2>{{localize "ME.Actor.Items"}}</h2>
    <div class="create-controls">
      <button type="button" data-action="createItem" data-type="checklist" title="{{localize 'ME.Actor.AddChecklist'}}">
        <i class="fas fa-list-check"></i> {{localize "ME.Actor.ItemTypeChecklist"}}
      </button>
      <button type="button" data-action="createItem" data-type="move" title="{{localize 'ME.Actor.AddMove'}}">
        <i class="fas fa-person-running"></i> {{localize "ME.Actor.ItemTypeMove"}}
      </button>
      <button type="button" data-action="createItem" data-type="text" title="{{localize 'ME.Actor.AddText'}}">
        <i class="fas fa-file-lines"></i> {{localize "ME.Actor.ItemTypeText"}}
      </button>
      <button type="button" data-action="createItem" data-type="question" title="{{localize 'ME.Actor.AddQuestion'}}">
        <i class="fas fa-circle-question"></i> {{localize "ME.Actor.ItemTypeQuestion"}}
      </button>
    </div>
  </div>

  <ul class="items-list">
    {{#each items as |item|}}
    <li class="item-row" data-item-id="{{item.id}}">
      <div class="sort-controls">
        <button type="button" class="icon-btn" data-action="moveItemUp" {{#if @first}}disabled{{/if}} title="{{localize 'ME.Actor.MoveUp'}}">
          <i class="fas fa-arrow-up"></i>
        </button>
        <button type="button" class="icon-btn" data-action="moveItemDown" {{#if @last}}disabled{{/if}} title="{{localize 'ME.Actor.MoveDown'}}">
          <i class="fas fa-arrow-down"></i>
        </button>
      </div>
      <img class="item-img" src="{{item.img}}" title="{{item.type}}" />
      <span class="item-name{{#if (eq item.type "move")}}{{#unless item.system.active}} item-name--inactive{{/unless}}{{/if}}">{{item.name}}</span>
      <span class="item-type tag">{{item.type}}</span>
      {{#if (eq item.type "move")}}
      <label class="active-toggle" title="{{localize 'ME.Actor.Active'}}">
        <input type="checkbox" data-action="toggleMoveActive" data-item-id="{{item.id}}" {{checked item.system.active}} />
        <span>{{localize "ME.Actor.Active"}}</span>
      </label>
      {{/if}}
      <div class="item-controls">
        <a class="icon-btn" data-action="editItem" title="{{localize 'ME.Actor.EditItem'}}"><i class="fas fa-edit"></i></a>
        <a class="icon-btn delete-btn" data-action="deleteItem" title="{{localize 'ME.Actor.DeleteItem'}}"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="empty-list">{{localize "ME.Actor.NoItemsThreat"}}</li>
    {{/each}}
  </ul>
</div>
