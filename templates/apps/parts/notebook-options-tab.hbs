<div class="na-panel{{#if activeOptions}} active{{/if}}" data-na-panel="options">
  <div class="na-scroll-area">
    <div class="na-options-tab">
      <section class="na-options-section">
        <h3>{{localize "ME.Notebook.Options.SceneHeading"}}</h3>
        <p>{{localize "ME.Notebook.Options.RemoveNotebookHint"}}</p>
        <button type="button" class="na-btn na-btn-danger" data-action="removeNotebook">
          <i class="fas fa-unlink"></i> {{localize "ME.Notebook.Options.RemoveNotebook"}}
        </button>
      </section>
    </div>
  </div>
</div>
