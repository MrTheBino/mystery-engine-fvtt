<div class="roll-dialog-body">
  <div class="roll-dialog-ability">
    <span class="roll-dialog-ability-name">{{abilityName}}</span>
    <span class="roll-dialog-ability-modifier">{{abilityModifier}}</span>
  </div>
  <div class="roll-dialog-buttons">
    <button type="button" class="roll-btn advantage-btn" data-roll="advantage">
      <i class="fas fa-dice-d6"></i>
      {{localize "ME.RollDialog.RollAdvantage"}}
    </button>
    <button type="button" class="roll-btn disadvantage-btn" data-roll="disadvantage">
      <i class="fas fa-dice-d6"></i>
      {{localize "ME.RollDialog.RollDisadvantage"}}
    </button>
  </div>
</div>
