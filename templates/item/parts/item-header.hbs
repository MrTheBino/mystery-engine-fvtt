<header class="sheet-header">
  <img class="profile-img" src="{{document.img}}" data-edit="img" title="{{document.name}}" />
  <div class="header-fields">
    <input class="title-input" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'ME.Item.Header.NamePlaceholder'}}" />
    <div class="position-row">
      <label>{{localize "ME.Item.Header.Position"}}</label>
      <input type="number" name="system.position" value="{{system.position}}" />
    </div>
  </div>
</header>
